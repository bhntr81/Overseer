#!/usr/bin/python3
"""Focus the existing project hub, or attach a new display after it is closed."""
import json
from pathlib import Path
import re
import subprocess
import sys
from window_state import hide_from_switchers

record = Path.home() / '.local/state/overseer/terminal-hub.json'
settings = json.loads(record.read_text())


def window_pid(window):
    result = subprocess.run(['xprop', '-id', window, '_NET_WM_PID'], text=True, capture_output=True)
    match = re.search(r'= (\d+)', result.stdout)
    return int(match.group(1)) if match else None


if '--restore-hidden' in sys.argv:
    for item in settings.get('hidden_windows', []):
        if window_pid(item['window']) == item['pid']:
            hide_from_switchers(item['window'], False)
            subprocess.run(['xdotool', 'windowmap', item['window']], check=True)
    sys.exit(0)

# Find any existing verified project display, even after it changed sessions.
clients = subprocess.run(['tmux', 'list-clients', '-F', '#{client_pid}\t#{session_name}'],
                         capture_output=True, text=True, check=True).stdout
parents = set()
for line in clients.splitlines():
    pid, session = line.split('\t', 1)
    if session in settings['labels']:
        try:
            fields = (Path('/proc') / pid / 'stat').read_text().rsplit(')', 1)[1].split()
            parents.add(int(fields[1]))
        except (OSError, ValueError):
            pass
windows = subprocess.run(['xprop', '-root', '_NET_CLIENT_LIST'], capture_output=True, text=True, check=True).stdout
for window in re.findall(r'0x[0-9a-f]+', windows):
    if window_pid(window) in parents:
        subprocess.run(['xdotool', 'windowmap', window], check=True)
        subprocess.run(['xdotool', 'windowactivate', window], check=True)
        sys.exit(0)
available = set(subprocess.run(['tmux', 'list-sessions', '-F', '#{session_name}'],
                              capture_output=True, text=True, check=True).stdout.splitlines())
target = settings['session']
if target not in available:
    target = next((s for s in sorted(settings['labels'], key=lambda s: settings['labels'][s].casefold())
                   if s in available), None)
if target is None:
    sys.exit('No existing Overseer project sessions. Start or resume a project first.')
subprocess.Popen(['qterminal', '-e', 'tmux', 'attach-session', '-t', '=' + target],
                 start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
