#!/usr/bin/env python3
"""Refresh, or check, the prompt-writing snapshot in `promptwriting/`.

The canonical prompt-writing project lives outside this repository, beside it.
This copies its method files here so an agent on another machine has them. It
only reads the canonical project. It never copies `prompts/` or `DESIGN.md`,
and it copies `LESSONS.md` without its rows: this repository is public and
those hold details of other, private projects.

    python3 scripts/sync-promptwriting           write the snapshot
    python3 scripts/sync-promptwriting --check   exit 1 when the snapshot differs

Exit codes: 0 ok (or, for --check, the canonical project is absent on this
machine), 1 the snapshot differs, 2 a write was asked for and the canonical
project is absent.
"""
import argparse
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]
FILES = ('AGENTS.md', 'GUIDE.md', 'LESSONS.md', 'README.md', 'TEMPLATE.md')
NOTE = '''
## This copy

This directory is a snapshot written by `scripts/sync-promptwriting` from the
author's canonical project; edit that project, not this copy. Two parts are
kept there and not published here, because they quote other, private projects:
`DESIGN.md` (the design record, including the findings F1 to F11 that
`GUIDE.md` cites) and the `prompts/` archive. `LESSONS.md` is published
without its rows for the same reason.
'''


def render(name, text):
    """Return the published form of one canonical file."""
    if name == 'LESSONS.md':
        lines = text.splitlines(keepends=True)
        for index, line in enumerate(lines):
            if re.match(r'\|\s*-{3}', line):
                return ''.join(lines[:index + 1])
    if name == 'README.md':
        return text.rstrip('\n') + '\n' + NOTE
    return text


def expected(source):
    return {name: render(name, (source / name).read_text(encoding='utf-8')) for name in FILES}


def differences(snapshot, wanted):
    """Return a line for each file that is missing, different, or unexpected."""
    problems = []
    for name, text in wanted.items():
        path = snapshot / name
        if not path.is_file():
            problems.append('%s is missing from the snapshot' % name)
        elif path.read_text(encoding='utf-8') != text:
            problems.append('%s differs from the canonical project' % name)
    if snapshot.is_dir():
        for path in sorted(snapshot.iterdir()):
            if path.name not in wanted:
                problems.append('%s is in the snapshot but is not a published file' % path.name)
    return problems


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--source', type=Path, default=ROOT.parent / 'PROMPTWRITING')
    parser.add_argument('--snapshot', type=Path, default=ROOT / 'promptwriting')
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args(argv[1:])
    if not all((args.source / name).is_file() for name in FILES):
        print('the canonical prompt-writing project is absent at %s' % args.source,
              file=sys.stdout if args.check else sys.stderr)
        return 0 if args.check else 2
    wanted = expected(args.source)
    if args.check:
        problems = differences(args.snapshot, wanted)
        for problem in problems:
            print(problem, file=sys.stderr)
        if problems:
            print('run python3 scripts/sync-promptwriting to refresh the snapshot', file=sys.stderr)
            return 1
        print('the snapshot matches the canonical project (%d files)' % len(wanted))
        return 0
    args.snapshot.mkdir(parents=True, exist_ok=True)
    for name, text in wanted.items():
        with open(args.snapshot / name, 'w', encoding='utf-8', newline='\n') as handle:
            handle.write(text)
    print('wrote %d files to %s' % (len(wanted), args.snapshot))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
